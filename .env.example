# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / SQLite auto-fallback)
# If PostgreSQL is not reachable, the server automatically uses local SQLite seamlessly
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reverse_api_platform
DB_TYPE=auto
SQLITE_PATH=./data/platform.db

# Storage Directories
STORAGE_DIR=./storage/uploads
EXTRACT_DIR=./storage/extracted

# AI Engine Configuration (Optional - platform has full heuristic/rule fallback when no key is set)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
